# The one config file you author, and the one the app writes for itself.
config.json
.state.json
# Superseded by config.json (scripts/migrate_config.py folds them in). Kept ignored so an
# un-migrated checkout still can't leak credentials.
.env
# ...and any hand-made copy of it. A `.env.bak` kept while migrating held every live secret and
# was NOT covered by the bare `.env` line above, so `git add -A` would have committed it.
.env.*
profiles.json
warehouses.json
cards.json
# The legacy Google private key scripts/migrate_config.py still reads from the repo root.
service_account.json
.costco/
.bestbuy_capture/
.amazon_capture/
.amazon_business_capture/
.bg_capture/
.receipt_capture/
.amazon_business_signin_capture/
.amazon_consumer_signin_capture/
.costco_signin_capture/
data/
logs/
# `python -m scripts.backup` output: each zip holds config.json and every live credential.
backups/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Claude Code, machine-local: .claude/ holds the permission allowlist and the portable session store
# (full transcripts, real PII); CLAUDE.local.md is personal notes; .mcp.json can carry MCP server
# keys. Never commit.
.claude/
CLAUDE.local.md
.mcp.json
.vscode/
PORTABLE.md
setup-portable.cmd
setup-portable.ps1
