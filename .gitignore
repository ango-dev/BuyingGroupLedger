# The one config file you author, and the one the app writes for itself.
config.json
.state.json
# Superseded by config.json (scripts/migrate_config.py folds them in). Kept ignored so an
# un-migrated checkout still can't leak credentials.
.env
# ...and any hand-made copy of it. A `.env.bak` kept while migrating held every live secret and
# was NOT covered by the bare `.env` line above, so `git add -A` would have committed it.
.env.*
service_account.json
profiles.json
warehouses.json
cards.json
.costco/
.bestbuy_capture/
.amazon_capture/
.amazon_business_capture/
.bg_capture/
.receipt_capture/
.amazon_business_signin_capture/
.amazon_consumer_signin_capture/
.costco_signin_capture/
data/
logs/
# `python -m scripts.backup` output: each zip holds config.json and every live credential.
backups/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Claude Code personal permission allowlist (machine-local, not project config)
.claude/settings.local.json

# Portable Claude Code session store — holds full transcripts (real PII). Never commit.
.claude/
.vscode/
PORTABLE.md
setup-portable.cmd
setup-portable.ps1
