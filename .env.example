# Browser-Use Cloud (API v4) — get a key at https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=
# v4 is bring-your-own-model only. gpt-5.6-luna is confirmed working (test run succeeded,
# $0.002188 for a trivial task) and is the cheapest option, though it's not in the SDK's
# own model list — that list is stale/incomplete, so treat it as a starting point, not gospel.
# Other confirmed-in-SDK options: minimax-m3, gemini-3-flash, gemini-3.5-flash, grok-4.5,
# gpt-5.5, gpt-5.6, claude-sonnet-5, claude-opus-4.7/4.8, glm-5.2
BROWSER_USE_LLM=gpt-5.6-luna
# Per-run cost cap in USD — stops a run that's spiraling on retries
BROWSER_USE_MAX_COST_USD=0.50

# Browser-Use profile IDs, proxy credentials, and which retailers each profile is logged into
# live in profiles.json (copy profiles.example.json to get started).

# How many calendar days back to scan for new orders (today = 0). Default 1 = today and yesterday.
LOOKBACK_DAYS=1

# How often the CONTAINER runs the scrape, in hours (1-23). Default 3 = 8 runs/day. Read by
# docker-compose.yml, so changing it here needs only `docker compose up -d` — no file edit.
# (The non-Docker path takes its interval as an argument to ./scripts/install_cron.sh instead.)
#
# The floor is set by MaxOutDeals, not by this code: MOD allows 10 payout reads per day and every
# run spends exactly one, so 3h (8/day) leaves 2 spare — and a manual `sync_tracking` spends one
# too, even as a DRY RUN. Go below 3h and preflight warns on every container start; the effect is
# that payout/premium/status write-back stops until the daily reset, while tracking submission
# keeps working. Nothing local blocks it — MOD's server is the only real authority.
RUN_INTERVAL_HOURS=3

# Cashback rate of LAST resort — used when a row's card isn't listed in cards.json at all (or is
# listed with neither an overall rate nor a rate for that retailer). A decimal fraction — 0.02 = 2%;
# "2%" is also accepted. Per-card overall rates AND per-retailer overrides go in cards.json (copy
# cards.example.json). Leave blank/0 to assume no cashback unless a card says otherwise.
DEFAULT_CASHBACK_RATE=0.02

# Google Sheets ledger (service account auth — share the sheet with the service account's email)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET_NAME=Orders

# Alerts (fired when a retailer session is logged out, or a run fails)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
DISCORD_WEBHOOK_URL=

# Buying group APIs (see buying_groups/). Leave a group's credentials blank to skip it entirely.

# Master switch for the buying-group sync at the end of every scheduled run. OFF by default because
# an unattended run SUBMITS TRACKING to third parties and FILES BFMR INSURANCE — real money, and
# effectively not undoable (MOD ignores numbers already in its system and publishes no update
# endpoint). Validate by hand first, then turn it on:
#   python -m scripts.bg_probe                 # read-only recon
#   python -m sync_tracking                    # dry run; shows exactly what would be sent
#   python -m sync_tracking --apply --limit 1  # one package per group
BUYING_GROUP_SYNC_ENABLED=0

# BFMR — key AND secret, from Developer Tools in your BFMR account settings. These go in two
# separate headers (API-KEY / API-SECRET); it is NOT a bearer token.
BFMR_API_BASE_URL=https://api.bfmr.com
BFMR_API_KEY=
BFMR_API_SECRET=
# Only insure shipments worth at least this much. Filing costs a REAL PREMIUM per shipment on every
# unattended run, so this is the knob that bounds that spend. 0 = insure everything.
#
# BFMR charges ~0.45% with a $2.00 MINIMUM, measured across 30 real filings (2026-08-13):
#     $189.99 -> $2.00 (1.05%)      $749.97 -> $4.00  (0.53%)
#     $299.00 -> $2.20 (0.74%)     $1599.96 -> $7.40  (0.46%)
#     $399.00 -> $2.60 (0.65%)     $2299.00 -> $10.20 (0.44%)
# So below roughly $450 the floor dominates and the effective rate passes 1%. 500 keeps every
# automatic filing at the true rate.
BFMR_MIN_INSURANCE_VALUE=0

# MaxOutDeals — a bearer token, PLUS your account's user id and email, which MOD requires in the
# body of every request. Note MOD also enforces an IP ALLOWLIST: add the machine that runs this to
# the firewall tab in your MOD profile, or every call is rejected regardless of the token.
MAXOUTDEALS_API_BASE_URL=https://www.maxoutdeals.com
MAXOUTDEALS_API_KEY=
MAXOUTDEALS_USER_ID=
MAXOUTDEALS_EMAIL=

# --- Receipt capture -> OCI Object Storage (optional) ------------------------------------------
# During each scrape, every newly-seen order's receipt page (Amazon's print invoice; the
# order-details page elsewhere) is rendered to PDF over the CDP browser, uploaded here, and linked
# from the sheet's Receipt Link column. A receipt is what a BFMR support ticket wants as proof of
# purchase, and a delivered order is terminal -- never re-read -- so the capture has to happen while
# the order is still being scraped.
#
# OCI_BUCKET IS THE MASTER SWITCH: blank means the whole feature is inert (no browser, no upload,
# no error). Capture only ever runs for an order with NO receipt already stored, so a routine
# re-check run opens no browser at all.
#
# Uploads use OCI's S3 COMPATIBILITY API, so these are an OCI "customer secret key" (Identity ->
# your user -> Customer Secret Keys), NOT the API signing key.
OCI_BUCKET=
OCI_S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_S3_REGION=<region>
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=

# A bucket-level Pre-Authenticated Request, created ONCE by hand in the OCI console:
#   Bucket -> Pre-Authenticated Requests -> Create
#   Target: Bucket | Access type: Permit object reads | Expiry: far future
#   and leave "Enable Object Listing" UNCHECKED -- receipts are PII, and listing would let anyone
#   holding this URL enumerate every order you have placed, not just fetch a link they already have.
#
# NB "Objects with prefix" is a SEPARATE target type, not a checkbox under Bucket. It works too, but
# its URL already ends in the prefix while this code appends the full key (which starts "receipts/")
# -- so trim the value below back to the part ending in /o if you use it.
# PARs cannot be minted through the S3 API (that needs OCI's native API and a different credential
# set), and boto3 presigned URLs expire after at most 7 days -- so one manual PAR is what gives the
# sheet a link that keeps working. Each object's URL is this prefix + "/" + the object key.
#
# ! TREAT THIS AS A SECRET. Anyone with it can read every receipt under the prefix, and a receipt
# ! carries your name, delivery address, card last 4 and order totals. Revoke and reissue in the
# ! console if it leaks.
OCI_PAR_URL_PREFIX=https://objectstorage.<region>.oraclecloud.com/p/<par-secret>/n/<namespace>/b/<bucket>/o

# Off switch that leaves the credentials in place. Blank OCI_BUCKET already disables capture; use
# this to pause it without deleting a working config.
RECEIPT_CAPTURE_ENABLED=1
