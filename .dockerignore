# Never bake secrets or local env into the image — these are provided at runtime
# (env_file / mounted volumes). See docker-compose.yml.
#
# config.json IS the credential store now: the Google private key, both buying-group API keys, the
# proxy and retailer passwords all live in it. `COPY . .` would
# bake the lot into the image, and the :ro bind mount would then hide it perfectly — the mounted
# file wins at runtime, so everything behaves exactly as it should while the image quietly carries
# a full set of live credentials wherever it is pushed or saved.
config.json
.state.json
.env
.env.*
profiles.json
warehouses.json
cards.json
.costco/
# Recon/capture output — REAL PII (names, addresses, card last 4, order totals, whole receipts).
# These are gitignored, but .gitignore does not apply to `COPY . .`, so they must be named here too
# or they get baked into the image and travel wherever it is pushed.
.amazon_capture/
.amazon_business_capture/
.bestbuy_capture/
.bg_capture/
.receipt_capture/
.venv/
__pycache__/
*.pyc
data/
logs/
# Backup zips hold config.json and every live credential -- never baked into an image.
backups/
.git/
# ...except the two tiny files that say which commit this is: scripts/backup.py stamps a backup's
# manifest with it, and inside the image there is no `git` to ask (the commit column on the
# Settings page's Backup panel was blank, 2026-09-18).
!.git/HEAD
!.git/refs/heads/
!.git/packed-refs
.gitignore
